<%- include('../partials/header', { title: title }) %>

<div class="card auth-card">
    <h1>Регистрация</h1>

    <% if (errors.length > 0) { %>
        <div class="errors">
            <ul>
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form action="/register" method="POST" class="form">
        <label for="name">Имя</label>
        <input type="text" id="name" name="name" value="<%= form.name || '' %>">

        <label for="email">Email</label>
        <input type="text" id="email" name="email" value="<%= form.email || '' %>">

        <!-- Пароль никогда не подставляется обратно в форму -->
        <label for="password">Пароль (минимум 6 символов)</label>
        <input type="password" id="password" name="password">

        <label for="confirmPassword">Подтверждение пароля</label>
        <input type="password" id="confirmPassword" name="confirmPassword">

        <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
    </form>

    <p class="auth-switch">Уже есть аккаунт? <a href="/login">Войти</a></p>
</div>

<%- include('../partials/footer') %>
