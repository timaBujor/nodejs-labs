<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Учебные курсы</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/courses" class="logo">Система управления учебными курсами</a>
            <nav class="nav">
                <a href="/courses">Курсы</a>
                <a href="/teachers">Преподаватели</a>

                <% if (currentUser) { %>
                    <a href="/statistics">Статистика</a>
                    <% if (currentUser.role === 'admin') { %>
                        <a href="/courses/new">Добавить курс</a>
                        <a href="/teachers/new">Добавить преподавателя</a>
                    <% } %>
                    <span class="nav-user">
                        <%= currentUser.name %>
                        <% if (currentUser.role === 'admin') { %><span class="badge">admin</span><% } %>
                    </span>
                    <a href="/profile">Профиль</a>
                    <form action="/logout" method="POST" class="nav-logout">
                        <button type="submit">Выход</button>
                    </form>
                <% } else { %>
                    <a href="/login">Вход</a>
                    <a href="/register">Регистрация</a>
                <% } %>
            </nav>
        </div>
    </header>

    <!-- Блок уведомлений (WebSocket) -->
    <section id="notifications" class="notifications" aria-live="polite">
        <div class="notifications-header">Уведомления</div>
        <div id="notifications-list"></div>
    </section>

    <main class="container">
