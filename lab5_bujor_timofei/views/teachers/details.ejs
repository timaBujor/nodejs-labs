<%- include('../partials/header', { title: title }) %>

<a href="/teachers" class="back-link">← К списку преподавателей</a>

<div class="card">
    <h1><%= teacher.name %></h1>
    <dl class="details">
        <dt>Email</dt>
        <dd><%= teacher.email %></dd>

        <dt>Кафедра</dt>
        <dd><%= teacher.department %></dd>

        <dt>Учёная степень</dt>
        <dd><%= teacher.academicDegree %></dd>

        <dt>Количество курсов</dt>
        <dd><%= teacher.Courses.length %></dd>
    </dl>

    <div class="actions">
        <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/teachers/<%= teacher.id %>/edit" class="btn btn-edit">Редактировать</a>
        <form action="/teachers/<%= teacher.id %>/delete" method="POST"
              onsubmit="return confirm('Удалить этого преподавателя?')">
            <button type="submit" class="btn btn-delete">Удалить</button>
        </form>
        <% } %>
    </div>
</div>

<h2>Курсы преподавателя</h2>
<% if (teacher.Courses.length === 0) { %>
    <p class="empty">У преподавателя нет курсов</p>
<% } else { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Название</th><th>Кредиты</th><th>Семестр</th><th></th></tr>
            </thead>
            <tbody>
                <% teacher.Courses.forEach(course => { %>
                    <tr>
                        <td><%= course.title %></td>
                        <td><%= course.credits %></td>
                        <td><%= course.semester %></td>
                        <td><a href="/courses/<%= course.id %>" class="btn btn-view">Просмотр</a></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>
