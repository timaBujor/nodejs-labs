<%- include('../partials/header', { title: title }) %>

<div class="page-head">
    <h1>Преподаватели</h1>
    <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/teachers/new" class="btn btn-primary">+ Добавить преподавателя</a>
    <% } %>
</div>

<% if (teachers.length === 0) { %>
    <p class="empty">Преподаватели не найдены</p>
<% } else { %>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Имя</th>
                    <th>Email</th>
                    <th>Кафедра</th>
                    <th>Учёная степень</th>
                    <th>Курсов</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                <% teachers.forEach(teacher => { %>
                    <tr>
                        <td><%= teacher.name %></td>
                        <td><%= teacher.email %></td>
                        <td><%= teacher.department %></td>
                        <td><%= teacher.academicDegree %></td>
                        <td><%= teacher.Courses.length %></td>
                        <td class="actions">
                            <a href="/teachers/<%= teacher.id %>" class="btn btn-view">Просмотр</a>
                            <% if (currentUser && currentUser.role === 'admin') { %>
                            <a href="/teachers/<%= teacher.id %>/edit" class="btn btn-edit">Редактировать</a>
                            <form action="/teachers/<%= teacher.id %>/delete" method="POST"
                                  onsubmit="return confirm('Удалить этого преподавателя?')">
                                <button type="submit" class="btn btn-delete">Удалить</button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../partials/footer') %>
